# Himanshu: you can IGNORE this file.
# Your two Supabase values go straight into Vercel
# (Project → Settings → Environment Variables) during setup.
# This file only exists for local development by AI/developers:
# copy it to ".env.local" and fill in the values.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
